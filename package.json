{
  "name": "learning-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run data:sync && npm run data:counts && npm run data:navigation && vite",
    "build": "npm run build:frontend && npm run data:sync && npm run data:counts && npm run data:navigation",
    "build:frontend": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "data:check": "node scripts/sync-java-data.mjs --check",
    "data:sync": "node scripts/sync-java-data.mjs --sync",
    "data:counts": "node scripts/build-module-content-counts.mjs",
    "data:navigation": "node scripts/build-module-navigation.mjs",
    "test:data": "node --test scripts/tests/*.test.mjs",
    "test:worker": "tsx --test worker/tests/*.test.ts",
    "test:local-run": "tsx --test scripts/tests/local-run-*.test.ts scripts/tests/local-run-panel.test.tsx scripts/tests/local-run-sidebar.test.tsx scripts/tests/module-catalog-retry.test.ts",
    "check:worker": "tsc --noEmit -p tsconfig.worker.json",
    "check:wrangler": "wrangler deploy --dry-run --outdir .wrangler/local-run-check"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "mermaid": "^11.17.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "fflate": "^0.8.2",
    "happy-dom": "^20.14.6",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "wrangler": "^4.149.0"
  }
}
