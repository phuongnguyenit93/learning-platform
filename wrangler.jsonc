{
  "name": "learning-platform",
  "compatibility_date": "2026-10-10",
  "main": "./worker/index.ts",
  "vars": {
    "LOCAL_RUN_ENABLED": "true"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOCAL_RUN_COORDINATOR", "class_name": "LocalRunCoordinator" }
    ]
  },
  "exports": {
    "LocalRunCoordinator": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [
    {
      "name": "BUILD_RATE_LIMITER",
      "namespace_id": "9217344",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "previews": {
    "vars": {
      "LOCAL_RUN_ENABLED": "false"
    },
    "durable_objects": {
      "bindings": [
        { "name": "LOCAL_RUN_COORDINATOR", "class_name": "LocalRunCoordinator" }
      ]
    },
    "ratelimits": [
      {
        "name": "BUILD_RATE_LIMITER",
        "namespace_id": "9217345",
        "simple": { "limit": 3, "period": 60 }
      }
    ]
  }
}
